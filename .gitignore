# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments
my_venv/
venv/
.env/

# Data caches (auto-downloaded by torchvision)
me1/data/

# Continue.dev agent configs (contain live API keys)
me2/.continue/

# ME2 build artifacts (regeneratable — keep out of git)
me2/**/*.pt
me2/**/*.onnx
me2/**/*.onnx.data
# ME2 build artifacts (regeneratable — keep out of git)
me2/**/*.pt
me2/**/*.onnx
me2/**/*.onnx.data
# Hand-authored reply audio IS source — keep it in git.
me2/**/venv/
me2/**/venv/

# macOS
.DS_Store

# ME2 runtime data / TTS history (generated at runtime, not source)
me2/checkpoints_tts/
me2/data/

# Hand-authored reply audio IS source — keep it in git.
# (Must come AFTER the me2/**/*.wav rule above.)
!me2/assets/replies/*.wav

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Build / training artifacts (regenerate, don't commit)
*.pt
*.onnx
*.bak
checkpoints/
data/mels/
*.log

# ONNX ground truth: the committed deployable for m4 / daniel-pc / pi.
# Carve the versioned models/onnx/ tree back out of the *.onnx ignore so
# every machine pulls the exact same artifact + provenance manifest.json.
!models/onnx/
!models/onnx/**/
!models/onnx/**/*.onnx
!models/onnx/**/*.json

# Editors / OS
.DS_Store
.idea/
.vscode/

# Tooling configs that may contain secrets
.continue/
*.env

# Synthetic benchmark clips (regenerable test data, not source)
bench_wavs/
